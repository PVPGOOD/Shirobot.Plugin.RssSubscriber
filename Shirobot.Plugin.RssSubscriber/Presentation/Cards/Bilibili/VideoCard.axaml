<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Shirobot.Plugin.RssSubscriber.Presentation"
             x:DataType="vm:CardViewModel"
             x:Class="Shirobot.Plugin.RssSubscriber.Presentation.Cards.Bilibili.VideoCard">
  <Border Width="500" Background="{DynamicResource M3CardBg}"
          BorderBrush="{DynamicResource M3CardBorder}" BorderThickness="1"
          CornerRadius="24" Padding="18" ClipToBounds="True">
    <Border.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="M3CardBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3CardBorder" Color="#E7E0EC" />
            <SolidColorBrush x:Key="M3TextPrimary" Color="#1D1B20" />
            <SolidColorBrush x:Key="M3TextSecondary" Color="#49454F" />
            <SolidColorBrush x:Key="M3TextMuted" Color="#79747E" />
            <SolidColorBrush x:Key="M3AvatarBg" Color="#E6E0E9" />
            <SolidColorBrush x:Key="M3AvatarIcon" Color="#49454F" />
            <SolidColorBrush x:Key="M3PlayBadgeBg" Color="#DCE2F9" />
            <SolidColorBrush x:Key="M3PlayBadgeText" Color="#001847" />
            <SolidColorBrush x:Key="M3BadgeBg" Color="#ECE6F0" />
            <SolidColorBrush x:Key="M3BadgeText" Color="#49454F" />
            <SolidColorBrush x:Key="M3BrandBadgeBg" Color="#FFD8E4" />
            <SolidColorBrush x:Key="M3BrandBadgeText" Color="#633B48" />
            <SolidColorBrush x:Key="M3MediaPlaceholder" Color="#E6E0E9" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="M3CardBg" Color="#1D1B20" />
            <SolidColorBrush x:Key="M3CardBorder" Color="#49454F" />
            <SolidColorBrush x:Key="M3TextPrimary" Color="#E6E0E9" />
            <SolidColorBrush x:Key="M3TextSecondary" Color="#CAC4D0" />
            <SolidColorBrush x:Key="M3TextMuted" Color="#938F99" />
            <SolidColorBrush x:Key="M3AvatarBg" Color="#36343B" />
            <SolidColorBrush x:Key="M3AvatarIcon" Color="#CAC4D0" />
            <SolidColorBrush x:Key="M3PlayBadgeBg" Color="#283556" />
            <SolidColorBrush x:Key="M3PlayBadgeText" Color="#DBE2F9" />
            <SolidColorBrush x:Key="M3BadgeBg" Color="#2B2930" />
            <SolidColorBrush x:Key="M3BadgeText" Color="#E6E0E9" />
            <SolidColorBrush x:Key="M3BrandBadgeBg" Color="#4A2532" />
            <SolidColorBrush x:Key="M3BrandBadgeText" Color="#FFB0C8" />
            <SolidColorBrush x:Key="M3MediaPlaceholder" Color="#2B2930" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Border.Resources>

    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource M3AvatarBg}"
                  ClipToBounds="True" IsVisible="{Binding HasAvatar}">
            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding AuthorName}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource M3TextPrimary}" />
            <TextBlock Text="Bilibili · 视频" FontSize="11" Foreground="{DynamicResource M3TextMuted}" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="2" Background="{DynamicResource M3BrandBadgeBg}" CornerRadius="8"
                Padding="8,4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="M19 7h-3.17l1.59-1.59L16 4l-3 3h-2L8 4 6.59 5.41 8.17 7H5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zm0 11H5V9h14v9z M8 12.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5zm8 0a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5z"
                  Fill="{DynamicResource M3BrandBadgeText}" Stretch="Uniform" Width="13" Height="13"
                  VerticalAlignment="Center" />
            <TextBlock Text="视频" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource M3BrandBadgeText}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Height="220" CornerRadius="16" Background="{DynamicResource M3MediaPlaceholder}"
              ClipToBounds="True" IsVisible="{Binding HasCover}">
        <Grid>
          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
          <Border Background="#99000000" CornerRadius="6" Padding="7,3"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                  IsVisible="{Binding HasDuration}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M8 5v14l11-7z" Fill="White" Stretch="Uniform" Width="9" Height="9"
                    VerticalAlignment="Center" />
              <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource M3TextPrimary}" TextWrapping="Wrap" LineHeight="22" />
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasCategory}">
          <Path Data="M19 7h-3.17l1.59-1.59L16 4l-3 3h-2L8 4 6.59 5.41 8.17 7H5c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zm0 11H5V9h14v9z"
                Fill="{DynamicResource M3TextMuted}" Stretch="Uniform" Width="11" Height="11"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding CategoryText}" FontSize="11" Foreground="{DynamicResource M3TextMuted}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTags}">
          <TextBlock Text="{Binding TagsText}" FontSize="11" Foreground="{DynamicResource M3TextMuted}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPublishedDate}">
          <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"
                Fill="{DynamicResource M3TextMuted}" Stretch="Uniform" Width="11" Height="11"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding PublishedDateText}" FontSize="11" Foreground="{DynamicResource M3TextMuted}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="18"
                 Foreground="{DynamicResource M3TextSecondary}" MaxLines="2"
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />

      <WrapPanel Margin="0,2,0,0" ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasVideoStats}">
        <Border Background="{DynamicResource M3PlayBadgeBg}" CornerRadius="8" Padding="10,5"
                IsVisible="{Binding HasViewCount}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="M8 5v14l11-7z" Fill="{DynamicResource M3PlayBadgeText}" Stretch="Uniform"
                  Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ViewCountLabel}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource M3PlayBadgeText}" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource M3BadgeBg}" CornerRadius="8" Padding="8,5"
                IsVisible="{Binding HasLikeCount}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"
                  Fill="{DynamicResource M3BadgeText}" Stretch="Uniform" Width="10" Height="10"
                  VerticalAlignment="Center" />
            <TextBlock Text="{Binding LikeCountLabel}" FontSize="11" Foreground="{DynamicResource M3BadgeText}"
                       FontWeight="Medium" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource M3BadgeBg}" CornerRadius="8" Padding="8,5"
                IsVisible="{Binding HasCoinCount}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-2.5-9.5h5v3h-5zm0-2h5v1h-5z"
                  Fill="{DynamicResource M3BadgeText}" Stretch="Uniform" Width="10" Height="10"
                  VerticalAlignment="Center" />
            <TextBlock Text="{Binding CoinCountLabel}" FontSize="11" Foreground="{DynamicResource M3BadgeText}"
                       FontWeight="Medium" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource M3BadgeBg}" CornerRadius="8" Padding="8,5"
                IsVisible="{Binding HasFavoriteCount}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                  Fill="{DynamicResource M3BadgeText}" Stretch="Uniform" Width="10" Height="10"
                  VerticalAlignment="Center" />
            <TextBlock Text="{Binding FavoriteCountLabel}" FontSize="11" Foreground="{DynamicResource M3BadgeText}"
                       FontWeight="Medium" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource M3BadgeBg}" CornerRadius="8" Padding="8,5"
                IsVisible="{Binding HasShareCount}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"
                  Fill="{DynamicResource M3BadgeText}" Stretch="Uniform" Width="10" Height="10"
                  VerticalAlignment="Center" />
            <TextBlock Text="{Binding ShareCountLabel}" FontSize="11" Foreground="{DynamicResource M3BadgeText}"
                       FontWeight="Medium" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
